APP_ENV=competition
APP_PORT=8000
FRONTEND_PORT=5173
SERVE_FRONTEND=auto
FRONTEND_DIST_DIR=../frontend/dist
APP_EXAMPLES_DIR=./data/examples
APP_UPLOAD_DIR=./data/uploads
APP_KNOWLEDGE_DIR=./data/knowledge
# Run scripts/init-config.ps1 or scripts/init-config.sh to generate local role tokens.
# AUTH_MODE=off is only permitted for an explicitly enabled local unsafe demo.
AUTH_MODE=token
ALLOW_INSECURE_AUTH_OFF=false
AUTH_TOKEN=
AUTH_TOKEN_ROLE=admin
AUTH_OPERATOR_TOKEN=
AUTH_REVIEWER_TOKEN=
AUTH_ADMIN_TOKEN=
LLM_PROVIDER=mock
REMOTE_API_MODE=auto
PROVIDER_RETRY_COUNT=1
PROVIDER_BACKOFF_SECONDS=0.5
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2
RAG_CONTEXT_MAX_CHARS=4000
RAG_USE_STRUCTURED_LLM_ANSWER=true
RAG_ALLOW_LLM_NO_EVIDENCE_FALLBACK=false
LLM_API_KEY=
LLM_BASE_URL=
MULTIMODAL_PROVIDER=mock
MULTIMODAL_TIMEOUT_SECONDS=30
LOCAL_MULTIMODAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MULTIMODAL_MODEL=llava:latest
LOCAL_MULTIMODAL_API_KEY=ollama
LOCAL_MULTIMODAL_MAX_TOKENS=1200
LOCAL_MULTIMODAL_TEMPERATURE=0.2
OCR_PROVIDER=mock
OCR_LANG=ch
OCR_MAX_PAGES=3
OCR_TIMEOUT_SECONDS=30
MINERU_ENABLED=true
MINERU_BACKEND=pipeline
MINERU_LANG=ch
MINERU_TIMEOUT_SECONDS=180
MINERU_SMART_TIMEOUT_SECONDS=180
MINERU_FULL_TIMEOUT_SECONDS=600
MINERU_API_URL=
PDF_RENDERER=auto
PDF_RENDER_TIMEOUT_SECONDS=60
SMART_VISUAL_DPI=120
FULL_VISUAL_DPI=180
SMART_VISUAL_MAX_PAGES=80
FULL_VISUAL_MAX_PAGES=300
FULL_VISUAL_MAX_ASSETS=500
MANUAL_VISUAL_TIMEOUT_SECONDS=45
MANUAL_VISUAL_RETRY_COUNT=1
MANUAL_VISUAL_RETRY_DELAY_SECONDS=2
# LoongArch/Kylin Docker target defaults to sqlite because Chroma/hnswlib wheels are not reliable on loongarch64.
# Use chroma only on environments where chromadb installs cleanly.
RAG_VECTOR_STORE=sqlite
RAG_VECTOR_SQLITE_ENGINE=python_scan
RAG_VECTOR_ENHANCER=off
RAG_VECTOR_FALLBACK_LOCAL=on
RAG_RRF_K=60
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
RAG_RETRIEVAL_MIN_CANDIDATES=20
RAG_RETRIEVAL_MAX_CANDIDATES=100
RAG_RERANK_PROVIDER=none
# RAG_RERANK_PROVIDER=heuristic enables a local metadata-aware rerank pass after RRF. Unsupported providers fall back to none.
APP_CHROMA_DIR=./data/knowledge/chroma
APP_VECTOR_DB_PATH=./data/knowledge/vector-index.sqlite3
APP_VECTOR_INDEX_PATH=./data/knowledge/vector-index.json
RAG_VECTOR_DIMENSION=384
SQLITE_VEC_EXTENSION_PATH=
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_COLLECTION=repair_knowledge_chunks
RAG_QDRANT_TIMEOUT_SECONDS=3
RAG_EMBEDDING_PROVIDER=openai
# Embedding uses OPENAI_API_KEY + OPENAI_BASE_URL + /embeddings.
# text-embedding-3-small is the OpenAI default only; OpenAI-compatible providers must set their own embedding model or use RAG_EMBEDDING_PROVIDER=hash.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_API_STYLE=openai_compatible
EMBEDDING_TIMEOUT_SECONDS=20
# OpenAI-compatible LLM
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# chat_completions: OpenAI-compatible providers. responses: OpenAI official Responses API.
OPENAI_API_STYLE=chat_completions
OPENAI_ENABLE_THINKING=false

MULTIMODAL_PROVIDER=mock
MULTIMODAL_OPENAI_BASE_URL=
MULTIMODAL_OPENAI_API_KEY=
MULTIMODAL_OPENAI_MODEL=
MULTIMODAL_OPENAI_API_STYLE=chat_completions
MULTIMODAL_OPENAI_ENABLE_THINKING=false
# OpenAI-compatible examples:
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1, OPENAI_MODEL=deepseek-chat, OPENAI_API_STYLE=chat_completions
# Qwen/DashScope compatible: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, OPENAI_API_STYLE=chat_completions
# SiliconFlow compatible: OPENAI_BASE_URL=https://api.siliconflow.cn/v1, OPENAI_API_STYLE=chat_completions
# Local multimodal example: MULTIMODAL_PROVIDER=local, LOCAL_MULTIMODAL_BASE_URL=http://127.0.0.1:11434/v1, LOCAL_MULTIMODAL_MODEL=llava:latest
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
