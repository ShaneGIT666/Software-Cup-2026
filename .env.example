APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./data/app.db
LLM_PROVIDER=mock
REMOTE_API_MODE=auto
PROVIDER_RETRY_COUNT=1
PROVIDER_BACKOFF_SECONDS=0.5
LLM_TIMEOUT_SECONDS=20
LLM_API_KEY=
LLM_BASE_URL=
MULTIMODAL_PROVIDER=mock
MULTIMODAL_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# responses: OpenAI official Responses API. chat_completions: OpenAI-compatible providers.
OPENAI_API_STYLE=responses
# OpenAI-compatible examples:
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1, OPENAI_MODEL=deepseek-chat, OPENAI_API_STYLE=chat_completions
# Qwen/DashScope compatible: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, OPENAI_API_STYLE=chat_completions
# SiliconFlow compatible: OPENAI_BASE_URL=https://api.siliconflow.cn/v1, OPENAI_API_STYLE=chat_completions
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
UPLOAD_DIR=./data/uploads
